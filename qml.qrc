        <file alias="fonts/NotoSans-Bold">fonts/NotoSans-Bold.ttf</file>
        <file alias="fonts/NotoSans-Light">fonts/NotoSans-Light.ttf</file>
        <file alias="fonts/NotoSansCJKsc-Regular">fonts/NotoSansCJKsc-Regular.otf</file>
        <file alias="fonts/NotoSansCJKsc-Medium">fonts/NotoSansCJKsc-Medium.otf</file>
        <file alias="fonts/NotoSansCJKsc-Bold">fonts/NotoSansCJKsc-Bold.otf</file>
        <file alias="fonts/NotoSansCJKsc-Light">fonts/NotoSansCJKsc-Light.otf</file>

        <file alias="SearchKeyboard.qml">qml/SearchKeyboard.qml</file>
    </qresource>
</RCC>
